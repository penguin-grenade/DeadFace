{
  "name": "bodycam-shooter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node tools/smoke.mjs",
    "package:artifact": "npm run build && node tools/artifact.mjs",
    "assets": "blender -b -P blender/build_all.py --",
    "assets:bpy": "python3 blender/build_all.py",
    "level:bpy": "python3 blender/build_level.py && npx --yes @gltf-transform/cli@4.5.1 meshopt public/level/level.glb public/level/level.glb"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "typescript": "^5.9.3",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0"
  }
}
